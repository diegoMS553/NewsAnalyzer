# =============================================================================
# CONFIGURACIÓN OPTIMIZADA PARA RENDER - REDUCCIÓN DE COSTOS
# =============================================================================

# =============================================================================
# TELEGRAM (REQUERIDO)
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Para múltiples destinatarios (opcional)
# TELEGRAM_CHAT_IDS=123456789,987654321,555666777

# =============================================================================
# APIs DE NOTICIAS (AL MENOS UNA REQUERIDA)
# =============================================================================

# Alpha Vantage - Excelente para análisis de sentimiento y tickers específicos
# Obtén tu key gratis en: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Perplexity Sonar - NUEVA API - Búsquedas web en tiempo real
# Obtén tu key en: https://www.perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_key_here

# NewsAPI - Noticias estructuradas (1000 requests gratis/día)
# Obtén tu key en: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# =============================================================================
# OPTIMIZACIONES DE RENDIMIENTO (CRÍTICO PARA RENDER)
# =============================================================================

# Timeout para requests de APIs principales (segundos)
# Recomendado: 8-10 para producción, 15 para desarrollo
API_REQUEST_TIMEOUT=8

# Número máximo de reintentos por API
# Recomendado: 1 para producción, 3 para desarrollo
API_MAX_RETRIES=1

# Delay entre reintentos (segundos)
# Recomendado: 1-2 para minimizar tiempo de ejecución
API_RETRY_DELAY=1

# Timeout para operaciones de fallback (segundos)
# Usado para Yahoo Finance scraping y RSS feeds
API_FALLBACK_TIMEOUT=4

# =============================================================================
# CONFIGURACIÓN DE PERPLEXITY
# =============================================================================

# Modelo optimizado para búsquedas web
# sonar-small-online: Más rápido y económico
# sonar-medium-online: Mayor calidad pero más costoso
PERPLEXITY_MODEL=sonar-small-online

# Máximo tokens por respuesta (controla costo directo)
# 1000 tokens = ~750 palabras, suficiente para 5-10 noticias
PERPLEXITY_MAX_TOKENS=1000

# Temperatura (0.0-1.0, menor = más determinístico)
# 0.2 recomendado para noticias (consistencia)
PERPLEXITY_TEMPERATURE=0.2

# =============================================================================
# CONFIGURACIÓN DE ALPHA VANTAGE
# =============================================================================

# Usar Alpha Vantage como fuente prioritaria (true/false)
ALPHA_VANTAGE_PRIORITY=true

# Tickers por defecto para noticias (separados por comas)
ALPHA_VANTAGE_DEFAULT_TICKERS=ORCL,MSFT,GOOGL,TSLA,NVDA,BTC,ETH,XRP,SOL,DOGE

# Temas por defecto para búsquedas
ALPHA_VANTAGE_DEFAULT_TOPICS=technology,financial_markets,earnings

# =============================================================================
# CONFIGURACIÓN GENERAL
# =============================================================================

# Máximo artículos por análisis (menor = más rápido)
# Recomendado: 8-10 para balance entre información y velocidad
MAX_NEWS_PER_ANALYSIS=8

# Intervalo entre análisis (horas)
ANALYSIS_INTERVAL_HOURS=4

# Umbral de sentimiento para notificaciones
SENTIMENT_THRESHOLD=0.1

# =============================================================================
# CONFIGURACIÓN DE TRADUCCIÓN
# =============================================================================

# Habilitar traducción de títulos (true/false)
# Deshabilitado en producción para velocidad
ENABLE_TITLE_TRANSLATION=false

# Idioma destino para traducciones
TRANSLATION_TARGET_LANGUAGE=es

# =============================================================================
# CONFIGURACIÓN DE RENDER/PRODUCCIÓN
# =============================================================================

# Habilitar web scraping (DESHABILITADO EN PRODUCCIÓN)
# El scraping es lento y puede causar timeouts en Render
ENABLE_WEB_SCRAPING=false

# Indicar que está en Render
RENDER_DEPLOYMENT=true

# Puerto del servidor (automático en Render)
PORT=8000

# =============================================================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# =============================================================================
# Descomenta las siguientes líneas para desarrollo local:

# API_REQUEST_TIMEOUT=15
# API_MAX_RETRIES=3
# API_RETRY_DELAY=3
# API_FALLBACK_TIMEOUT=10
# ENABLE_WEB_SCRAPING=true
# RENDER_DEPLOYMENT=false
# MAX_NEWS_PER_ANALYSIS=15

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. COSTOS EN RENDER:
#    - Tiempo de ejecución = Dinero gastado
#    - Configuraciones optimizadas pueden reducir costos 60-80%
#    - Timeouts cortos evitan esperas innecesarias
#
# 2. APIs RECOMENDADAS POR COSTO/BENEFICIO:
#    1. Perplexity (Mejor: tiempo real, sin rate limits)
#    2. Alpha Vantage (Bueno: análisis sentimiento, pero con limits)
#    3. NewsAPI (Básico: 1000 requests gratis/día)
#    4. Yahoo Finance (Gratis: siempre disponible como fallback)
#
# 3. MONITOREO:
#    - Observa logs por "timeout/connection error"
#    - Tiempo ideal de ejecución: < 90 segundos
#    - Meta: obtener 5-8 artículos por ejecución
#
# 4. TROUBLESHOOTING:
#    - Si hay muchos timeouts: aumenta API_REQUEST_TIMEOUT
#    - Si toma mucho tiempo: reduce MAX_NEWS_PER_ANALYSIS
#    - Si faltan noticias: agrega más APIs
#    - Si hay errores: verifica las API keys
#
# =============================================================================